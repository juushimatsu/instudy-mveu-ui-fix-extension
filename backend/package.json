{
  "name": "instudy-clicker-api",
  "version": "1.0.0",
  "description": "Cloudflare Workers API для кликера InStudy",
  "main": "src/index.js",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:create": "wrangler d1 create instudy-clicker-db",
    "db:migrate": "wrangler d1 execute instudy-clicker-db --file=./schema.sql",
    "kv:create": "wrangler kv:namespace create ONLINE_KV"
  },
  "devDependencies": {
    "wrangler": "^3.0.0"
  }
}
